# Configuration SMTP pour l'envoi des confirmations de réservation par email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_FROM="Mariage Delchere & Ihechukwu <votre-email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=delchere.dontsa@aims-cameroon.org

# Configuration Google Sheets (Webhook Google Apps Script)
# Déployez le script fourni dans scripts/GoogleAppsScript_RSVP.js sur votre Google Sheet et collez l'URL Web App ici :
NEXT_PUBLIC_GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_URL=

# Configuration facultative Airtable / Cartes
NEXT_PUBLIC_AIRTABLE_TOKEN=
NEXT_PUBLIC_AIRTABLE_BASE=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_PASSWORD=
NEXT_PUBLIC_WEBSITE_SKIP_PASSWORD=